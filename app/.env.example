# Copia este archivo a .env.local y rellena con la config del proyecto Firebase
# (digivend-dev o digivend-prod). La apiKey web de Firebase no es un secreto.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=digivend-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=digivend-dev
VITE_FIREBASE_STORAGE_BUCKET=digivend-dev.firebasestorage.app
VITE_FIREBASE_APP_ID=

# true para desarrollar contra los emuladores locales (firebase emulators:start)
VITE_USE_EMULATORS=true
